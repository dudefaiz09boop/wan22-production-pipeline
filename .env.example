# WAN 2.2 Production Pipeline - environment template
#
# Copy to .env and fill in the values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# --- Hugging Face (required: model + base model downloads) ---
# https://huggingface.co/settings/tokens  (read scope is enough)
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# --- Civitai (anatomy LoRAs) ---
# https://civitai.com/user/account
CIVITAI_API_KEY=

# --- Kaggle (LoRA training + dataset access) ---
# Username plus the key from kaggle.json. Leave KAGGLE_KEY empty if you
# authenticate the CLI with `kaggle auth login` instead.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- AIC Cloud ---
# The AIC Cloud API covers VPS, email, domains and billing only.
# GPU instances are created in the dashboard, so AIC_API_KEY is optional
# and used for wallet/billing checks, not for provisioning GPUs.
AIC_API_BASE=https://api.aiccloud.in
AIC_API_KEY=

# --- Pipeline paths (on the GPU instance) ---
WORKSPACE=/workspace
MODEL_DIR=/workspace/models
OUTPUT_DIR=/workspace/output
COMFY_URL=http://127.0.0.1:8188
COMFY_PORT=8188

# --- Render defaults ---
# auto picks fp16 (>=44GB VRAM), fp8 (>=22GB), or gguf_q8 (below 22GB).
# Set explicitly when the card is borderline: a Quadro RTX 8000 reports 48 GB
# but is Turing (sm_75), so it has no bf16 and no Flash Attention 2.
WAN_PRECISION=fp16
PARALLEL_DOWNLOADS=4
SKIP_VALIDATION=false

# --- Lipsync ---
# s2v: Wan 2.2 S2V, one audio stream (default, cheapest)
# infinitetalk: Wan 2.1 InfiniteTalk Multi, two speakers with masks
# off: skip the lipsync pass
LIPSYNC_ENGINE=infinitetalk
LIPSYNC_STEPS=6

# --- Start frame repair ---
# Regenerate frames that fail the quality audit before rendering.
REPAIR_FRAMES=true

# --- Realism ---
# NAG makes the negative prompt actually bite at CFG 1.0. Roughly doubles
# render time, so it is opt-in.
NAG=false
NAG_SCALE=11.0
NAG_ALPHA=0.25
NAG_TAU=2.5
# Film grain, halation, chromatic aberration and a colour pass on the final
# cut. Forces a re-encode of every clip.
GRADE=true

# --- Result retrieval ---
# Leave PULL_HOST empty to publish results over HTTP and pull them with curl.
# Set it to user@host to have the instance scp results to you directly.
PULL_HOST=
DOWNLOAD_PORT=8000
# Set true to stop the instance automatically after rendering.
AUTO_SHUTDOWN=false

# --- Optional LLM helpers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
NUMES_API_KEY=
HORDE_API_KEY=
